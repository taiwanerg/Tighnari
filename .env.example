# Copy to .env; process environment wins. Never commit real credentials.
# Multiple URLs: comma or space separated (duplicates are ignored).
# TIGHNARI_DISCORD_WEBHOOK=https://discord.com/api/webhooks/ID1/TOKEN1,https://discord.com/api/webhooks/ID2/TOKEN2
TIGHNARI_DISCORD_WEBHOOK=
TIGHNARI_DATABASE=runtime/events.sqlite3
# Public HTTPS origin for canonical URLs, sitemaps and Discord detail links (no trailing slash).
# Leave empty to use the incoming request's base URL for local development.
TIGHNARI_PUBLIC_URL=
TIGHNARI_PICKER=auto
TIGHNARI_MAX_STATIONS=60
TIGHNARI_INGEST_TOKEN=
# Accept delayed SeedLink packets (seconds); regional channels retain 10 minutes of its own data.
TIGHNARI_MAX_DATA_DELAY_S=1800
# Check for new waveform batches every two seconds; unchanged stations are cached.
TIGHNARI_ANALYSIS_INTERVAL_S=2
# Mwp is an optional independent background update, never a regional-location prerequisite.
TIGHNARI_LIVE_MWP=true
# BATS FDSN is unavailable (checked 2026-11-22); disabled by default.
# Enable only after verifying a working BATS_URL. Existing explicit true settings still apply.
# Enrichment waits for the public 15-minute delay and the full waveform window.
TIGHNARI_BATS_ENABLED=false
TIGHNARI_BATS_URL=http://batsws.earth.sinica.edu.tw:8080
TIGHNARI_BATS_DELAY_S=900
TIGHNARI_BATS_POLL_S=60
# Close-up radius applies only to the optional detail-page view (25–500 km).
TIGHNARI_MAP_RADIUS_KM=100
# Legacy SAIU_* names are accepted through the 0.2 transition.

# Manually excluded channels, NET.STA.LOC.CHA separated by commas (wildcards * ?).
# Two-letter CHA (TW.KNM.10.EH) drops the instrument; a Z rule (TW.ETLH.00.HHZ) drops the
# record from picking/location/polarity/magnitude but keeps its horizontals for CMT;
# an N/E rule (TW.PNG.00.HHN) blanks only that component (ML then rejects the station).
TIGHNARI_EXCLUDED_CHANNELS=

# Earthquakes older than 24 hours keep waveform images of the best eight stations.
TIGHNARI_WAVEFORM_RETENTION_HOURS=24
TIGHNARI_WAVEFORM_ARCHIVE_STATIONS=8

# GDMS post-event enrichment. Downloads need a manual Edge login (scripts/gdms_control.py login).
TIGHNARI_GDMS_ENABLED=true
TIGHNARI_GDMS_DELAY_S=900
TIGHNARI_GDMS_POLL_S=60
TIGHNARI_GDMS_SCHEDULE_JITTER_S=240
TIGHNARI_GDMS_AUTO_DOWNLOAD=false
# Secret operational webhook for manual-login reminders. Never expose its value.
TIGHNARI_GDMS_ATTENTION_WEBHOOK=
TIGHNARI_GDMS_MECHANISM_PUBLISH=true
# Local S/P and SH/P validation artifacts for GDMS-enriched events.
TIGHNARI_FOCAL_JOINT_SHADOW=false

# Hoshi admin: server-local credential file (two lines: account, password).
# Never commit this file. Missing/invalid credentials disable admin login.
TIGHNARI_ADMIN_CREDENTIALS_FILE=login.txt
# Turnstile site key is public; secret key stays server-side. Set both to enable.
TIGHNARI_TURNSTILE_SITE_KEY=
TIGHNARI_TURNSTILE_SECRET_KEY=
# Optional bridge lets a LAN-IP login use a widget registered to the public hostname.
# Example: TIGHNARI_TURNSTILE_FRAME_ORIGIN=https://quake.example.org
TIGHNARI_TURNSTILE_FRAME_ORIGIN=
# Example: TIGHNARI_ADMIN_LAN_ORIGINS=http://192.168.1.10
TIGHNARI_ADMIN_LAN_ORIGINS=

# Experimental Taiwan regional CMT. Public results also require validation.json.
TIGHNARI_REGIONAL_CMT_ENABLED=false
TIGHNARI_REGIONAL_CMT_PUBLISH=false
TIGHNARI_REGIONAL_CMT_ENSEMBLE=false
TIGHNARI_REGIONAL_CMT_MOMENT=false
TIGHNARI_REGIONAL_CMT_STORE=runtime/cmt-greens
# Optional BATS archive override. EarthScope also supplies public TW waveforms.
TIGHNARI_REGIONAL_CMT_BATS_URL=
TIGHNARI_ADAPTIVE_CMT_ENABLED=false
TIGHNARI_ADAPTIVE_CMT_PYTHON=
TIGHNARI_ADAPTIVE_WPHASE_PYTHON=
TIGHNARI_ADAPTIVE_WPHASE_GREENS=
TIGHNARI_ADAPTIVE_GLOBAL_MIN_MAGNITUDE=6.0
TIGHNARI_ADAPTIVE_GLOBAL_STORE=runtime/global-cmt/gf_stores/global_20s_shallow
# One isolated CMT calculation; the whole process tree is stopped after this (600–7200 s).
TIGHNARI_ADAPTIVE_CMT_TIMEOUT_S=2700
